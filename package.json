{
  "name": "library-managment",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "node scripts/dev.mjs start",
    "test": "npm test -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:start": "docker compose up -d db"
  }
}
