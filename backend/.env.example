# Copy to backend/.env (git-ignored) and adjust as needed.

# PostgreSQL used by the API, drizzle-kit and the seed script.
DATABASE_URL=postgres://library:library@127.0.0.1:5434/library

# Public URL of the frontend. Email links are built from this, never from the request.
APP_URL=http://localhost:3000

# API port. The frontend proxies /api/* here.
PORT=4000

# Optional: real email delivery. Without SMTP_URL, messages stay in the outbox at /dev/mail.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM="Libraria <no-reply@example.com>"
