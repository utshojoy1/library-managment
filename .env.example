# Copy to .env (git-ignored) and adjust as needed.

# PostgreSQL used by the app and by drizzle-kit.
DATABASE_URL=postgres://library:library@127.0.0.1:5434/library

# Optional: real email delivery.
# Without these, verification/reset messages stay in the outbox at /dev/mail.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM="Libraria <no-reply@example.com>"
